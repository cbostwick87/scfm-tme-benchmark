# ============================================================
# scfm-tme-benchmark -- exclusions
# Authored as the first file of the first commit.
# Large inputs/intermediates are reproducible by documented
# regeneration (see README); they are deliberately NOT stored here.
# No git-lfs.
# ============================================================

# --- credentials / secrets / environment identity -----------
.env
.env.*
*.pem
*.key
*_rsa
*_ed25519
*_ecdsa
id_*
.ssh/
.netrc
.aws/
aws_config
credentials
*.token
*token*.json
.secrets/
local.yaml
local.yml
site.yaml
*.local.yaml

# --- large data: raw, processed, embeddings, weights --------
data/
raw/
processed/
embeddings/
# Model WEIGHTS live on the data volume, never in git. Anchored to the repo root
# so it cannot also swallow source code under src/scfmbench/models/ -- an
# unanchored `models/` silently excluded the Geneformer encoder module and would
# have made the repository non-reproducible while every push reported success.
/models/
checkpoints/
hf_cache/
torch_cache/
*.h5
*.h5ad
*.loom
*.zarr/
*.npy
*.npz
*.pt
*.pth
*.bin
*.safetensors
*.mtx
*.mtx.gz
*.tar
*.tar.gz
*.tgz
*.zip

# --- split indices: only the small manifests are tracked ----
splits/*.npy
splits/*.parquet
!splits/README.md

# --- results: tidy tables T1-T4 ARE tracked (see README);
#     per-run shards and scratch are not ----------------------
results/shards/
results/_scratch/
results/*.tmp
logs/
*.log

# --- python ------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
envs/
miniforge/
miniconda/
.conda/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- os / editor -------------------------------------------
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# --- internal planning documents are NOT committable ---------
*brief*.xml
*_brief.*
planning/
